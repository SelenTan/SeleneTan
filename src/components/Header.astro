---
import { url, BASE_PATH } from "../config";

const items = [
    ["", "About Me"],
    ["projects/", "Research & Engineering"],
    ["cv/", "CV"],
    ["blog/", "Blog"],
    ["personal/", "Personal"],
];
const path = Astro.url.pathname.slice(BASE_PATH.length).replace(/\/$/, "");
---
<header class="site-header">
    <nav aria-label="Main navigation">
        {items.map(([href, label]) => {
            const prefix = href.replace(/\/$/, "");
            const current = path === prefix || (prefix !== "" && path.startsWith(href));
            return <a href={url(href)} aria-current={current ? "page" : undefined}>{label}</a>;
        })}
    </nav>
</header>
