---
import { type ProjectsSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import { url } from "../config";
export interface Props extends ProjectsSchema {}
const { title, description, period, badge, cvBullets, github, liveUrl } = Astro.props;
---
<BaseLayout title={`${title} | Selene Tan`} description={description}>
    <article class="career-section">
        <a href={url("projects/")}>Research & Engineering</a>
        <div class="project-heading">
            <h1>{title}</h1>
            <p class="entry-meta">{[badge, period].filter(Boolean).join(" · ")}</p>
        </div>
        {cvBullets ? (
            <ul class="project-bullets">
                {cvBullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
        ) : <p>{description}</p>}
        <div class="prose max-w-none"><slot /></div>
        {github && <p><a href={github}>View source on GitHub</a></p>}
        {liveUrl && <p><a href={liveUrl}>Live demo</a></p>}
    </article>
</BaseLayout>
