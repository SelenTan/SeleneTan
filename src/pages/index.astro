---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CareerSections from "../components/CareerSections.astro";
import { url } from "../config";

const featuredSlugs = [
    "stm32-freertos",
    "indoor-visible-light-positioning",
    "solar-planter",
    "vision-language-model-certification",
] as const;

const featuredProjects = await Promise.all(
    featuredSlugs.map(async (slug) => {
        const project = await getEntry("projects", slug);
        if (!project) throw new Error(`Featured project not found: ${slug}`);
        return project;
    }),
);
---
<BaseLayout>
    <section class="career-section" aria-labelledby="about">
        <h1 id="about">About Me</h1>
        <p>I’m Selene Tan, an embedded software and firmware engineer with an MSc in Integrated Machine Learning Systems from UCL and a First Class BEng in Electronic and Electrical Engineering from Queen Mary University of London. I work with C, Python, STM32 and FreeRTOS, with experience in sensing, signal processing and machine learning.</p>
        <p>I built a <a href={url("projects/stm32-freertos/")}>real-time STM32 system with FreeRTOS</a> and developed a <a href={url("projects/vision-language-model-certification/")}>framework for evaluating and certifying vision-language models</a>. I also built an <a href={url("projects/indoor-visible-light-positioning/")}>indoor positioning system using visible light</a> and processed LiDAR and image data for autonomous sailing and UAV-assisted navigation.</p>
        <p>I’m seeking graduate and junior roles in the UK, primarily in embedded software and firmware. I’m also interested in software engineering, robotics, autonomous systems and applied machine learning. <a href={url("projects/")}>Explore my projects</a> or <a href={url("cv/")}>view my CV</a>.</p>
        <p>Right to work in the UK. No visa sponsorship required.</p>
    </section>
    <CareerSections />
    <section class="career-section" aria-labelledby="selected-projects">
        <h2 id="selected-projects">Selected Projects</h2>
        {featuredProjects.map(({ slug, data }) => (
            <article class="career-entry">
                <h3><a href={url(`projects/${slug}/`)}>{data.title}</a></h3>
                <p>{data.description}</p>
            </article>
        ))}
        <p><a href={url("projects/")}>View all projects</a></p>
    </section>
</BaseLayout>
