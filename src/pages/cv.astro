---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CareerSections from "../components/CareerSections.astro";
import ProjectEntry from "../components/ProjectEntry.astro";
const projects = (await getCollection("projects")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="CV | Selene Tan">
    <section class="career-section"><h1>CV</h1></section>
    <CareerSections detailed />
    <section class="career-section">
        <h2>Projects</h2>
        {projects.map(({ slug, data }) => (
            <ProjectEntry slug={slug} data={data} />
        ))}
    </section>
    <section class="career-section">
        <h2>Skills</h2>
        <ul class="skills-list">
            <li><strong>Programming:</strong> Python, C, Embedded C and VHDL.</li>
            <li><strong>Machine learning:</strong> PyTorch, NumPy, model evaluation, CNNs, LSTMs and transfer learning.</li>
            <li><strong>Embedded systems:</strong> STM32 HAL, FreeRTOS, interrupt-driven firmware, 8051, sensor integration and serial communication.</li>
            <li><strong>Sensing and autonomous systems:</strong> Signal processing, optical positioning, LiDAR and image data processing, and autonomous navigation.</li>
            <li><strong>Hardware and tools:</strong> Schematic and PCB design, digital systems, Vivado, MATLAB, COMSOL, CST Studio Suite, STM32CubeIDE and Segger SystemView.</li>
            <li><strong>Data and security:</strong> SQL, SQLite and STRIDE threat modelling.</li>
            <li><strong>Languages:</strong> English and Mandarin.</li>
        </ul>
    </section>
</BaseLayout>
