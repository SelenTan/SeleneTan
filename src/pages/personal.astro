---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../config";
const posts = (await getCollection("personal")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Personal | Selene Tan">
    <section class="career-section">
        <h1>Personal</h1>
        <p>Stories, experiments and little discoveries from outside work.</p>
        <div class="personal-cat">
            <img src={url("tj11.jpg")} alt="Tian Ju the ginger cat" width="220" height="220" />
            <div><h2>Meet my cat</h2><p>His name is a mystery that no one fully agrees on.</p></div>
        </div>
        <p class="personal-social"><a href="https://www.instagram.com/labibibibibibu/">Instagram</a>
            <button type="button" class="secret-social-link">WhatsApp</button>
            <span role="status"></span>
        </p>
    </section>
    <section class="career-section">
        <h2>Stories and photos</h2>
        {posts.map(({ slug, data }) => (
            <article class="career-entry">
                <h3><a href={url(`personal/${slug}/`)}>{data.title}</a></h3>
                <p>{data.description}</p>
            </article>
        ))}
    </section>
</BaseLayout>

<style is:global>
    .secret-bubble-field {
        position: fixed;
        inset: 0;
        z-index: 70;
        pointer-events: none;
        overflow: hidden;
    }

    .secret-bubble {
        position: absolute;
        left: var(--bubble-left);
        top: var(--bubble-top);
        padding: 0.55rem 0.85rem;
        border: 2px solid #8f7652;
        border-radius: 999px;
        background: #fff8dc;
        color: #80684a;
        box-shadow: 0 4px 0 #d3b16f, 0 10px 18px rgb(88 65 38 / 18%);
        font-weight: 800;
        transform: translate(-50%, -50%) scale(0.75);
        animation: secret-bubble-float 1.45s ease-out forwards;
        white-space: nowrap;
    }

    .secret-bubble::after {
        position: absolute;
        right: 16%;
        bottom: -0.38rem;
        width: 0.65rem;
        height: 0.65rem;
        border-right: 2px solid #8f7652;
        border-bottom: 2px solid #8f7652;
        background: #fff8dc;
        content: "";
        transform: rotate(45deg);
    }

    @keyframes secret-bubble-float {
        0% {
            opacity: 0;
            transform: translate(-50%, 12px) scale(0.75);
        }

        15% {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1.04);
        }

        70% {
            opacity: 1;
            transform: translate(-50%, -78px) scale(1);
        }

        100% {
            opacity: 0;
            transform: translate(-50%, -110px) scale(0.92);
        }
    }
</style>

<script is:inline>
    function showSecretBubbles() {
        const field = document.createElement("div");
        field.className = "secret-bubble-field";
        document.body.appendChild(field);

        const positions = [
            ["44%", "76%"],
            ["55%", "69%"],
            ["48%", "59%"],
        ];

        positions.forEach(([left, top], index) => {
            window.setTimeout(() => {
                const bubble = document.createElement("div");
                bubble.className = "secret-bubble";
                bubble.textContent = "uh-oh! I'm keeping this secret";
                bubble.style.setProperty("--bubble-left", left);
                bubble.style.setProperty("--bubble-top", top);
                field.appendChild(bubble);
            }, index * 120);
        });

        window.setTimeout(() => field.remove(), 1900);
    }

    if (!window.__secretSocialReady) {
        window.__secretSocialReady = true;
        document.addEventListener("click", (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;

            const link = target.closest(".secret-social-link");
            if (!link) return;

            event.preventDefault();
            if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                target.closest(".secret-social-link")?.parentElement?.querySelector("[role=status]")?.replaceChildren("Uh-oh! I’m keeping this secret.");
                return;
            }
            showSecretBubbles();
        });
    }
</script>
